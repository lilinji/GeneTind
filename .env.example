# ==============================================================================
# GeneTind 官网发信邮件配置模板 (Email & SMTP Configuration)
# 复制此文件为 .env.local 并填入您的企业发信账号即可真实发信至 lilinji@genetind.com
# ==============================================================================

# 邮件接收目标邮箱（官网留言将自动转发至该邮箱）
CONTACT_RECEIVER_EMAIL=lilinji@genetind.com

# ------------------------------------------------------------------------------
# 发件服务器 (SMTP) 配置说明
# ------------------------------------------------------------------------------
# 常用企业邮箱 SMTP 地址与端口：
# 1. 腾讯企业邮 (Tencent Exmail)：
#    SMTP_HOST=smtp.exmail.qq.com
#    SMTP_PORT=465
# 2. 阿里企业邮 (Alibaba Qiye Mail)：
#    SMTP_HOST=smtp.qiye.aliyun.com
#    SMTP_PORT=465
# 3. 网易企业邮 (NetEase Qiye Mail)：
#    SMTP_HOST=smtphm.qiye.163.com
#    SMTP_PORT=465
# 4. QQ 个人邮箱：
#    SMTP_HOST=smtp.qq.com
#    SMTP_PORT=465
# ------------------------------------------------------------------------------

# SMTP 服务器地址（必填）
SMTP_HOST=smtp.qiye.aliyun.com

# SMTP 端口（SSL 推荐 465）
SMTP_PORT=465

# 发信账号（如 service@genetind.com 或您的发信邮箱）
SMTP_USER=lilinji@genetind.com

# 发信账号密码或专用客户端授权码
SMTP_PASS=LLJllj123

# 发件人显示名称与地址（选填，默认使用 SMTP_USER）
SMTP_FROM="GeneTind 官网咨询" <service@genetind.com>
